{
  "manifest_version": 3,
  "name": "Tabfire",
  "version": "1.0.0",
  "description": "Tabs slowly catch fire and burn away if you leave them open too long.",
  "permissions": ["tabs", "storage", "alarms", "scripting", "favicon"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tabfire",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "douse": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Douse the current tab"
    }
  },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["fire.js", "content.js"], "run_at": "document_idle" }
  ]
}
